# 报告生成服务环境变量模板：复制为 .env 后填写，启动时自动加载。
#   copy .env.example .env

# API 密钥。服务端不校验时填 EMPTY，但不能留空
OPENAI_API_KEY=your-api-key

# 模型名，必须与推理服务注册的模型 id 完全一致
LLM_MODEL=your-model-name

# OpenAI 兼容接口地址，例如 http://<推理服务器IP>:8888/v1
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1

# 单次生成最大 token 数，不能超过推理服务端的最大上下文长度限制
MAX_COMPLETION_TOKENS=16384

# 生成温度，越大越随机，建议0.1
LLM_TEMPERATURE=0.1
